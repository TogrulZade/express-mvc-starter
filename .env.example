PORT=3000
NODE_ENV=development
MONGO_URI="mongodb://127.0.0.1:27017/mydb"
CORS_ORIGIN=

# Cache is ready to use without a Redis server. TTL is in seconds.
CACHE_DRIVER=memory
CACHE_TTL=300
# Empty prefix uses the package.json project name (e.g. my-api:cache:).
CACHE_PREFIX=
CACHE_MAX_ITEMS=1000
CACHE_MAX_VALUE_BYTES=262144
CACHE_TIMEOUT_MS=2000
REDIS_URL="redis://127.0.0.1:6379"
