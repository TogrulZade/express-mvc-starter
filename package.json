{
  "name": "express-mvc-starter",
  "version": "1.0.0",
  "description": "Laravel-style Express.js MVC Boilerplate (Prisma)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^5.19.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
