{
  "name": "express-mvc-starter",
  "version": "1.0.0",
  "description": "Laravel-style Express.js MVC Boilerplate (Sequelize)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:migrate": "sequelize-cli db:migrate --config database/config.cjs --migrations-path database/migrations",
    "db:migrate:status": "sequelize-cli db:migrate:status --config database/config.cjs --migrations-path database/migrations"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^4.6.7",
    "sequelize": "^6.37.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
